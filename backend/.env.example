# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=4000

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string. Matches docker-compose defaults (user/password/db: leads)
DATABASE_URL=postgresql://leads:leads@localhost:5432/leads

# Meta webhook. VERIFY_TOKEN: any string you also enter in the Meta dashboard (handshake).
# APP_SECRET: from Meta App Dashboard > Settings > Basic; signs every webhook payload.
META_VERIFY_TOKEN=local-verify-token
META_APP_SECRET=local-dev-app-secret-change-me
